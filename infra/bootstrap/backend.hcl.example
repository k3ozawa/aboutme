# Copy to backend.hcl after the first `terraform apply` (see README.md), fill
# in the real bucket name from `terraform output state_bucket_name`, then run:
#   terraform init -backend-config=backend.hcl -migrate-state
bucket       = "CHANGE_ME-aboutme-terraform-state"
key          = "aboutme/bootstrap/terraform.tfstate"
region       = "ap-northeast-1"
encrypt      = true
use_lockfile = true
